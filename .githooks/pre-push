#!/usr/bin/env bash
# Pre-push gate: run the same checks CI runs, so a red push never leaves
# the machine. Bypass for emergencies: SKIP_CI_GATE=1 git push
set -euo pipefail

if [ "${SKIP_CI_GATE:-0}" = "1" ]; then
    echo "pre-push: SKIP_CI_GATE=1, skipping checks" >&2
    exit 0
fi

cd "$(git rev-parse --show-toplevel)"

echo "pre-push: ruff format --check" >&2
uv run ruff format --check . >&2

echo "pre-push: ruff check" >&2
uv run ruff check . >&2

echo "pre-push: mypy" >&2
uv run mypy >&2

echo "pre-push: pytest" >&2
uv run pytest -q >&2

echo "pre-push: all checks passed" >&2
